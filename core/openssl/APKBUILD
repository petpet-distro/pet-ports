# Maintainer: Emilia Luminé <eqilia@national.shitposting.agency>
pkgname="openssl"
pkgver="3.4.1"
pkgrel=0
pkgdesc="popular crypto library"
arch="x86_64"
# THE SITE FUCKING SUCKS
url="https://openssl-library.org"
license="Apache-2.0"
subpackages="$pkgname-dev"
depends="musl musl-dev perl"
builddir="$srcdir/$pkgname-$pkgver"
source="https://github.com/openssl/openssl/releases/download/openssl-$pkgver/openssl-$pkgver.tar.gz"

build() {
	./config \
		--prefix=/usr \
		--libdir=lib \
		--openssldir=/etc/ssl \
		shared \
		enable-ktls

	make
}

package() {
	make install DESTDIR="$pkgdir"
}

