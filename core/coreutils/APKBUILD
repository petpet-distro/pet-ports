# Maintainer: Emilia Luminé <eqilia@national.shitposting.agency>
pkgname="coreutils"
pkgver="9.6"
pkgrel=0
pkgdesc="gnu coreutils"
arch="x86_64"
url="https://www.gnu.org/software/coreutils"
license="GPL-3.0-or-later"
options="!check"
subpackages="$pkgname-doc"
depends="musl"
builddir="$srcdir/$pkgname-$pkgver"
source="https://ftp.gnu.org/gnu/coreutils/coreutils-$pkgver.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib/x86_64-musl \
		--bindir=/bin

	make
}

package() {
	DESTDIR="$pkgdir" make install
}

sha512sums="
