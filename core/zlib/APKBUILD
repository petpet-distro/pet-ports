# Maintainer: Emilia Luminé <eqilia@national.shitposting.agency>
pkgname="zlib"
pkgver="1.3.1"
pkgrel=0
pkgdesc="a \"spiffy yet [...] unobtrusive\" (de/)compression library"
arch="x86_64"
url="https://zlib.net"
license="Zlib"
subpackages="$pkgname-dev $pkgname-doc"
options="!check"
depends="musl"
builddir="$srcdir/$pkgname-$pkgver"
source="https://zlib.net/fossils/zlib-$pkgver.tar.gz"

build() {
	./configure \
		--prefix=/usr \
		--libdir=/lib \
		--sharedlibdir=/lib

	make
}

check() {
	make check
}

package() {
	DESTDIR="$pkgdir" make install
}

sha512sums="
