# Maintainer: Emilia Luminé <eqilia@national.shitposting.agency>
pkgname="musl"
pkgver="1.2.5"
pkgrel=0
pkgdesc="best musl package"
arch="x86_64"
url="https://musl.libc.org"
license="EXPAT"
subpackages="$pkgname-dev"
options="!check"
depends="musl"
builddir="$srcdir/$pkgname-$pkgver"
source="https://musl.libc.org/releases/musl-$pkgver.tar.gz"

build() {
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib/x86_64-musl \
		--bindir=/bin

	make
}

package() {
	DESTDIR="$pkgdir" make install
}

sha512sums="
