# Maintainer: Emilia Luminé <eqilia@national.shitposting.agency>
# the next thing im ducking porting is ed istg
pkgname="oksh"
pkgver="7.6"
pkgrel=2
pkgdesc="openbsd's korn shell"
arch="x86_64"
url="https://github.com/ibara/oksh"
license="Public-Domain"
subpackages="$pkgname-doc"
# not sure about the test thingie here
# and i cant be bothered to check
options="!check"
depends="musl"
builddir="$srcdir/$pkgname-$pkgver"
source="https://github.com/ibara/oksh/releases/download/oksh-$pkgver/oksh-$pkgver.tar.gz"

build() {
	./configure \
		--prefix=/usr \
		--disable-curses

	make
}

package() {
	DESTDIR="$pkgdir" make install

	mkdir "$pkgdir/bin"

	ln -s "$pkgdir/usr/bin/oksh" "$pkgdir/bin/sh"
}

sha512sums="
