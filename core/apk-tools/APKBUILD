pkgname="apk-tools"
pkgver="2.14.0"
pkgrel=0
pkgdesc="alpine package keeper"
arch="x86_64"
url="https://gitlab.alpinelinux.org/alpine/apk-tools"
license="GPL-2.0-only"
subpackages="$pkgname-dev $pkgname-doc"
depends="musl ca-certificates openssl-dev lua5.3 lua5.3-dev lua-lzlib zlib zlib-dev scdoc"
builddir="$srcdir/$pkgname-v$pkgver"
source="https://gitlab.alpinelinux.org/alpine/apk-tools/-/archive/v$pkgver/apk-tools-v$pkgver.tar.gz"

build() {
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" LIBDIR="/usr/lib" install
}

